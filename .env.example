# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Get from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID of the manager who receives order notifications and approves clients
# You can get your ID by messaging @userinfobot
MANAGER_CHAT_ID=123456789

# ─── Mini App ─────────────────────────────────────────────────────────────────
# Public HTTPS URL where the webapp is served (required by Telegram for Mini Apps)
# Example: https://orders.yourdomain.com
WEBAPP_URL=https://your-domain.com

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./data/bot.db

# ─── Initial admin ────────────────────────────────────────────────────────────
# Telegram username (without @) that gets admin rights automatically on first /start
ADMIN_USERNAME=msconsult
